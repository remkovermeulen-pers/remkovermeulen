          t: err.name,
          u: ""
        },
        h: loc.hash,
        l: loc.protocol.replace(":", ""),
        o: loc.host,
        p: loc.pathname,
        q: loc.search,
        pageKey: pk,
        service: meta?.service || "",
        serviceVersion: meta?.serviceVersion || "",
        t: tags,
